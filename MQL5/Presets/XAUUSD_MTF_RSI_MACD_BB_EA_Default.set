; XAUUSD_MTF_RSI_MACD_BB_EA - default preset
; In MT5: Strategy Tester > Expert Advisor: XAUUSD_MTF_RSI_MACD_BB_EA > Inputs tab > Load
; or on the chart's EA Inputs dialog > Load.
;
; Note: InpTF1/InpTF2/InpTF3 are stored below as raw ENUM_TIMEFRAMES values
; (15 = M15, 16385 = H1, 16388 = H4). If your MT5 build does not accept these
; lines for the timeframe inputs, just set them manually in the Inputs tab:
;   InpTF1 -> M15
;   InpTF2 -> H1
;   InpTF3 -> H4
;
InpMagicNumber=20260914
InpSlippagePoints=30
InpTradeXAUUSDOnly=true
InpMaxOpenPositions=4
InpAllowOpposite=false
InpTimerSeconds=60
InpTF1=15
InpTF2=16385
InpTF3=16388
InpWeightTF1=1.0
InpWeightTF2=1.5
InpWeightTF3=2.0
InpRsiPeriod=14
InpRsiLookback=2
InpRsiBuyLevel=47.0
