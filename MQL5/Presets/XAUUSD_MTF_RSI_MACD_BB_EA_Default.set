InpSwingPivotWidth=2
InpEntryThreshold=55.0
InpMinAgreeingTF=2
InpSwingBonusPoints=15.0
InpShowDashboard=true
InpUseFixedLot=true
InpFixedLot=0.01
InpRiskPercent=0.2
InpStopLossPips=60.0
InpUseTakeProfit=true
InpTakeProfitPips=100.0
InpMaxLotSize=5.0
InpMaxDailyLossPct=1.0
InpUseDailyTarget=false
