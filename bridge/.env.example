# Copy to .env (or set as real environment variables on your host) and fill in
# two DIFFERENT random secrets. Generate one with: openssl rand -hex 32

PORT=3000

# Sent by the EA (MT5 terminal) as the X-Api-Key header. Goes into the EA's
# InpBridgeApiKey input — it lives on your VPS, in a .set file.
EA_API_KEY=

# Sent by the iOS app as the X-Api-Key header. Goes into the app's Settings
# screen and is stored in the iOS Keychain.
APP_API_KEY=

# Optional: where to persist account state across restarts (defaults to
# ./data.json next to server.js).
# DATA_FILE=/var/lib/blazertest-bridge/data.json
