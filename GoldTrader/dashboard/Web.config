<?xml version="1.0" encoding="utf-8"?>
<!--
  GoldTrader dashboard - IIS site settings.

  The pages read ONE file: GoldTrader\logs\status.json, written once a minute
  by the running program (start.bat). Nothing here can place, change or
  close a trade.

  LogsFolder: leave empty when this site's folder is GoldTrader\dashboard
  (the normal setup, dashboard_setup.bat) - the logs folder next to it is
  used. Otherwise the full path, e.g. C:\GoldTrader\logs.

  Password: set with  python goldtrader.py dashboard-password  (stored as a
  salted hash in App_Data\password.txt, which IIS never serves).
-->
<configuration>
  <appSettings>
    <add key="LogsFolder" value="" />
    <!-- The page says "not updating" when status.json is older than this. -->
    <add key="StaleMinutes" value="5" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="64" />
    <customErrors mode="RemoteOnly" />
    <trace enabled="false" />
    <!-- Sign-in: one password, cookie kept 30 days on your phone (renewed while used). -->
    <authentication mode="Forms">
      <forms name=".GoldTraderDash" loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="43200"
             slidingExpiration="true" cookieless="UseCookies" protection="All" path="/" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <httpCookies httpOnlyCookies="true" />
  </system.web>

  <!-- The sign-in page itself is the only page reachable without the cookie. -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- App_Data (the password hash, the sample) is never served - IIS's default, stated here too. -->
        <hiddenSegments>
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
        <!-- Never serve data files directly, even if one is copied here by mistake.
             remove + add: IIS rejects an entry it already has (.config is in its defaults). -->
        <fileExtensions>
          <remove fileExtension=".json" />
          <add fileExtension=".json" allowed="false" />
          <remove fileExtension=".csv" />
          <add fileExtension=".csv" allowed="false" />
          <remove fileExtension=".txt" />
          <add fileExtension=".txt" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
          <remove fileExtension=".config" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
