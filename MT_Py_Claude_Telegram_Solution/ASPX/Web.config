<?xml version="1.0" encoding="utf-8"?>
<!--
  TelegramSMC Dashboard - web.config

  appSettings below point the dashboard at the two CSV files written by
  TelegramSMC_Copier.mq5 (TelegramSMC_Signals.csv) and
  TelegramSMC_TradeLogger.mq5 (TelegramSMC_Results.csv). Leave them blank (or
  pointing at a file that doesn't exist) and the dashboard falls back to the
  bundled sample data under App_Data, with a banner saying so - it never
  renders as broken on a fresh deployment.

  A "~/" prefix is an app-relative virtual path (resolved under this site's
  root, e.g. App_Data). An absolute path is a filesystem path, which can be a
  UNC path (e.g. \\MT5-BOX\C$\Users\you\AppData\Roaming\MetaQuotes\Terminal\
  <id>\MQL5\Files) if this site runs on a different machine than the MT5
  terminal and that share is reachable from the app pool's identity - see
  README.md for the details and the alternative (a scheduled copy job).
-->
<configuration>
  <appSettings>
    <add key="SignalsCsvPath" value="" />
    <add key="ResultsCsvPath" value="" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" executionTimeout="60" />
    <customErrors mode="RemoteOnly" />
    <!--
      This page reads local/UNC files and renders raw signal text server-side
      via HTML-escaping helpers - do not disable request validation or turn on
      trace/debug output on a deployment reachable outside a trusted network.
    -->
    <trace enabled="false" />
  </system.web>

  <system.webServer>
    <!-- Never serve the raw CSVs (or a stray .cs/.config) directly over HTTP. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".csv" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
